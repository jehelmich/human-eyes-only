# ─── Python ────────────────────────────────────────────────────────────────
# Unanchored on purpose. A virtualenv or a bytecode cache is never wanted
# anywhere in this tree, and `scripts/check-artifacts.mjs` catches the reverse
# mistake of a rule here swallowing something that is actually source.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ─── Rust ──────────────────────────────────────────────────────────────────
target/
pkg/
# Cargo.lock is committed: this is a shipped deliverable, not a library, and
# reproducible builds matter more than dependency-range flexibility.

# Local working material, deliberately untracked
.local/

# Agent working notes. The human-facing rules live in CONTRIBUTING.md.
CLAUDE.md
