{
  "name": "heo",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "HEO \u2014 adversarial rendering middleware for human-first web publishing.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "prepare": "sh scripts/setup-hooks.sh || true",
    "build": "pnpm --filter @heo/core --filter @heo/middleware run build",
    "typecheck": "tsc --build --force && pnpm --filter @heo/benchmark typecheck",
    "test": "pnpm -r run test",
    "compat": "pnpm --filter @heo/core build && pnpm --filter @heo/benchmark compat",
    "check:live": "pnpm build && node scripts/live-check.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "format": "biome format --write .",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "22.20.2",
    "parse5": "8.0.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
