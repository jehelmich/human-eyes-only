{
  "name": "@human-eyes-only/generator",
  "version": "0.1.0-alpha.3",
  "description": "Text to randomised SVG carrier generator (Rust/WASM).",
  "scripts": {
    "build": "cargo build --release --target wasm32-unknown-unknown && mkdir -p dist && cp target/wasm32-unknown-unknown/release/heo_generator.wasm dist/ && node scripts/optimise.mjs",
    "prepack": "pnpm run build",
    "test": "cargo test",
    "lint": "cargo clippy --all-targets -- -D warnings"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jehelmich/human-eyes-only"
  },
  "type": "module",
  "exports": {
    "./host": {
      "types": "./host/node.d.ts",
      "default": "./host/node.js"
    }
  },
  "files": [
    "host",
    "dist",
    "src",
    "Cargo.toml",
    "Cargo.lock",
    "README.md"
  ],
  "devDependencies": {
    "@human-eyes-only/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "engines": {
    "node": ">=20.11"
  }
}
