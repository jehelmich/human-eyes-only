{
  "name": "@human-eyes-only/middleware",
  "version": "0.1.0-alpha.1",
  "description": "Generic Node HTTP middleware adapter for HEO.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@human-eyes-only/core": "workspace:^",
    "@human-eyes-only/generator": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "22.20.2"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "engines": {
    "node": ">=20.11"
  }
}