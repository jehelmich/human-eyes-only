{
  "name": "@heo/middleware",
  "version": "0.0.0",
  "description": "Generic Node HTTP middleware adapter for HEO.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
